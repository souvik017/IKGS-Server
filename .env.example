# ---------------------------------------------------------------------------
# IKGS Solution - Backend environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ikgs
# Set to true only on a replica-set deployment (enables multi-document transactions)
MONGO_TRANSACTIONS=false

# Authentication - generate strong secrets for production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30d
JWT_COOKIE_NAME=ikgs_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_PUBLIC=20
RATE_LIMIT_LOGIN=10

# Image storage. Leave Cloudinary blank to use local disk storage (/uploads).
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ikgs

# Email (optional - reserved for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ikgssolution.com

# Seed script credentials (used once by `npm run seed`; never hardcoded)
ADMIN_NAME=IKGS Administrator
ADMIN_EMAIL=admin@ikgssolution.com
ADMIN_PASSWORD=
SITE_URL=http://localhost:5173
SERVICE_AREAS=Kolkata,Howrah,North 24 Parganas,South 24 Parganas
